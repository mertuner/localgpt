# Where the OpenAI-compatible model server lives, as seen BY THE BROWSER.
#
# Values are inlined at BUILD time, and Vite loads env files per MODE:
#
#   .env                    both dev and production   <- avoid for the API URL
#   .env.development[.local]  `npm run dev` only
#   .env.production[.local]   `npm run build` only
#
# So put a remote/tunnel URL in .env.production.local, never in .env --
# otherwise `npm run dev` would send local requests out over the internet.
#
# Files ending in .local are gitignored, which is what you want for tunnel
# hostnames: trycloudflare quick tunnels get a new hostname on every restart.

# --- default (no file needed) ---
# Unset => "/api", same-origin. Works in dev via the Vite proxy, and in
# production behind a reverse proxy forwarding /api to the model server.
# This is the recommended production setup: no CORS, nothing baked in.

# --- .env.production.local example ---
# Only needed when the deployed app has NO reverse proxy and must call the
# model server directly. That backend must send CORS headers.
# Note: no /api suffix -- the app appends /health and /v1/chat/completions.
# VITE_API_BASE_URL=https://your-tunnel.trycloudflare.com

# Fallback model id, used only until /health reports the loaded model.
# VITE_MODEL_ID=google/gemma-4-E2B-it
