# Where the OpenAI-compatible model server lives, as seen BY THE BROWSER.
#
# Leave unset (the default "/api") when the app and the model server are behind
# the same origin -- in dev that is the Vite proxy, in production a reverse
# proxy (nginx/Caddy) that forwards /api -> the model server. Same-origin is
# the recommended setup: no CORS, and no backend address baked into the bundle.
#
# Only set this if the model server is on a different origin, in which case it
# must send CORS headers. Note this value is inlined at BUILD time, not runtime.
# VITE_API_BASE_URL=https://models.example.com

# Fallback model id, used only until /health reports the loaded model.
# VITE_MODEL_ID=google/gemma-4-E2B-it
