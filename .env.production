# Loaded by `npm run build` only -- `npm run dev` ignores it and keeps using
# the local Vite proxy, so development never leaves the machine.
#
# Committed on purpose. This URL is not a secret: it is inlined into the JS
# bundle that the deployed site serves publicly, so keeping it out of git would
# hide it from nobody. Treat the endpoint itself as the thing to secure --
# anyone with this URL can run inference on the machine behind it.
#
# The browser calls this directly rather than going through a Netlify proxy,
# because Netlify buffers server-sent events: measured 26s to first token
# proxied vs 0.34s direct. Direct keeps token-by-token streaming.
#
# This is a Tailscale Funnel hostname: tied to the machine and tailnet rather
# than regenerated per session, so it survives restarts. It replaced a
# trycloudflare quick tunnel, whose hostname changed on every cloudflared
# restart and forced a rebuild each time.
#
# To repoint at a different backend: npm run set-tunnel -- <url> [--push]
VITE_API_BASE_URL=https://merts-macbook-air.tail098985.ts.net
