# Loaded by `npm run build` only -- `npm run dev` ignores it and keeps using
# the local Vite proxy, so development never leaves the machine.
#
# Committed on purpose. This URL is not a secret: it is inlined into the JS
# bundle that the deployed site serves publicly, so keeping it out of git would
# hide it from nobody. Treat the tunnel itself as the thing to secure.
#
# The browser calls this directly rather than going through a Netlify proxy,
# because Netlify buffers server-sent events: measured 26s to first token
# proxied vs 0.34s direct. Direct keeps token-by-token streaming.
#
# Quick tunnels get a new hostname on every cloudflared restart -- update this
# and redeploy when that happens, or use a named tunnel to stop the churn.
VITE_API_BASE_URL=https://leslie-steve-hours-football.trycloudflare.com
